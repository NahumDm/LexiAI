# ============================================================================
#  LexiAI frontend — environment template
#  Copy to `.env` (gitignored) and adjust for local or Vercel.
# ============================================================================

# Host port Vite proxies /api → Django (match WEB_HOST_PORT in backend .env)
VITE_DJANGO_PROXY_PORT=18000

# Dev: leave empty (same-origin + Vite proxy).
# Prod (Vercel build): required — full HTTPS Django origin, no trailing slash.
# BAD:  lexiai-production.up.railway.app
# GOOD: https://lexiai-production.up.railway.app
VITE_API_BASE_URL=

VITE_API_VERSION=v1
VITE_DEBUG_AUTH=false
VITE_DEBUG_API=false
