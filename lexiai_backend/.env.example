# ============================================================================
#  LexiAI — environment template
#  Copy to `.env` (which is gitignored) and fill in real values.
#  Generate SECRET_KEY with:
#    python -c "import secrets; print(secrets.token_urlsafe(64))"
# ============================================================================

# --- Django core ---
SECRET_KEY=your_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=lexiai_backend.settings.dev
LOG_LEVEL=INFO

# --- CORS / CSRF ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://user:pass@host:5432/db
POSTGRES_DB=lexiai_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Email ---
DEFAULT_FROM_EMAIL=noreply@lexiai.local

# --- LLM / RAG ---
# AI_LLM_BACKEND: auto | stub | mistral
#   auto    → use Mistral if MISTRAL_API_KEY is set, otherwise stub
#   mistral → force Mistral (falls back to stub + ERROR log if key is missing)
#   stub    → force in-process StubLLMClient (offline / CI)
AI_LLM_BACKEND=mistral
MISTRAL_API_KEY=your_api_key_here
MISTRAL_MODEL=mistral-medium-3.5
MISTRAL_TEMPERATURE=0.2
MISTRAL_MAX_TOKENS=1024
MISTRAL_TIMEOUT_SECONDS=60

# Warm the sentence-transformer in a background thread at process startup.
# Removes the ~45s cold-start latency hit on the first /api/v1/ask/ call.
AI_WARMUP_ON_STARTUP=true
