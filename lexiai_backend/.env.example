# ============================================================================
#  LexiAI — environment template
#  Copy to `.env` (which is gitignored) and fill in real values.
#  Generate SECRET_KEY with:
#    python -c "import secrets; print(secrets.token_urlsafe(64))"
# ============================================================================

# --- Django core ---
# Production (Railway): set SECRET_KEY in the service Variables tab — required, >=32 chars.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
#
# --- Railway production (set on the WEB + WORKER services in Railway Variables, not in git) ---
# REDIS_URL: The value `redis://redis:6379/0` below is ONLY for local Docker Compose (hostname `redis`).
#   On Railway you MUST add a Redis database, then copy its REDIS_URL from the Redis service Variables
#   into your backend service (or use Variable Reference). There is no universal URL inside the repo.
# ALLOWED_HOSTS: Comma-separated hostnames only — NO https://, NO path, NO quotes.
#   Production (prod.py): if unset or empty, defaults to * until you set real hosts.
#   Prefer your Railway public hostname, e.g. my-backend-production-a1b2.up.railway.app
#   (service → Settings → Networking). Custom domains: host1,host2

# --- Docker: published web port (host → container 8000) ---
# Windows often cannot bind host TCP 8000 ("forbidden by its access permissions"
# / Hyper-V excluded port ranges). docker-compose defaults WEB_HOST_PORT to 18000.
# Match the frontend dev proxy: create frontend/.env with VITE_DJANGO_PROXY_PORT=18000
# (or omit both to use defaults). For local `runserver` on 8000 without Docker, use
# VITE_DJANGO_PROXY_PORT=8000 in frontend/.env only.
WEB_HOST_PORT=18000
DJANGO_SETTINGS_MODULE=lexiai_backend.settings.dev
LOG_LEVEL=INFO

# --- CORS / CSRF ---
# Production (Railway): set CORS_ALLOWED_ORIGINS explicitly (HTTPS origins, comma-separated).
# CSRF_TRUSTED_ORIGINS is optional — prod mirrors CORS when unset. start.sh / worker.sh only require CORS.
# Dev only: CORS_ALLOWED_ORIGINS=* is interpreted as allow-any-Origin (see settings/dev.py). Do not use on Railway prod.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://user:pass@host:5432/db
POSTGRES_DB=lexiai_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer
# Production (prod): dj-database-url ssl_require (default true). Set DB_SSL_REQUIRE=false only if your DB URL/host rejects TLS and you accept the risk.
# DB_SSL_REQUIRE=true

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Celery prefork + PyTorch: docker-compose sets these on the *worker* service only.
# CELERY_WORKER_SKIP_EMBEDDING_WARMUP=1 — do not load SentenceTransformer in the parent before fork().
# OMP_NUM_THREADS=1 (and MKL_/OPENBLAS_/NUMEXPR_) — avoid OpenMP deadlocks in forked children.
# TOKENIZERS_PARALLELISM=false — avoid tokenizer multiprocessing issues in workers.
# CELERY_WORKER_SKIP_EMBEDDING_WARMUP=1
# OMP_NUM_THREADS=1
# MKL_NUM_THREADS=1
# OPENBLAS_NUM_THREADS=1
# NUMEXPR_NUM_THREADS=1
# TOKENIZERS_PARALLELISM=false

# --- Email ---
DEFAULT_FROM_EMAIL=noreply@lexiai.local

# --- LLM / RAG ---
# AI_LLM_BACKEND: auto | stub | mistral
#   auto    → use Mistral if MISTRAL_API_KEY is set, otherwise stub
#   mistral → force Mistral (falls back to stub + ERROR log if key is missing)
#   stub    → force in-process StubLLMClient (offline / CI)
AI_LLM_BACKEND=mistral
MISTRAL_API_KEY=your_api_key_here
MISTRAL_MODEL=mistral-medium-3.5
MISTRAL_TEMPERATURE=0.2
MISTRAL_MAX_TOKENS=1024
MISTRAL_TIMEOUT_SECONDS=60

# Warm the sentence-transformer in a background thread at process startup.
# Removes the ~45s cold-start latency hit on the first /api/v1/ask/ call.
AI_WARMUP_ON_STARTUP=true

# RAG strictness (cosine similarity floor; default top-k after filtering).
# Default in code is 0.2 (demo-friendly). Use 0.45–0.65 for stricter grounding in production.
# RAG_MIN_SIMILARITY=0.2
# RAG_DEFAULT_TOP_K=3
# Celery embedding sub-batch size (lower = less RAM per document during encode).
# EMBEDDING_BATCH_SIZE=8
